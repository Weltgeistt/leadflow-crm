# ─── Server ──────────────────────────────────────────────────────────────
PORT=3001
# SQLite database file (created automatically)
DATABASE_PATH=./data/leadflow.db
# Seed demo leads on first start when the database is empty
SEED_DEMO_DATA=true

# ─── Follow-ups & reminders ──────────────────────────────────────────────
# A lead in "New" or "Contacted" with no activity for this many days is flagged
FOLLOW_UP_AFTER_DAYS=3
# When the daily "needs attention" digest is emailed (cron syntax, server time)
DIGEST_CRON=0 8 * * *
# Who receives the daily digest
OWNER_EMAIL=you@yourcompany.com
OWNER_NAME=Alex

# ─── Email ───────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to run in preview mode: emails are written to ./outbox/
# as .eml + .html files and shown in the app's Outbox tab. Nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LeadFlow Studio <hello@yourcompany.com>"
OUTBOX_DIR=./outbox

# Public URL of the web app, used for links inside emails
# APP_URL=http://localhost:5173/
