{
  "name": "leadflow",
  "version": "1.0.0",
  "description": "LeadFlow — a mini CRM with automated follow-up emails, reminders and a drag-and-drop pipeline.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts --dev",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "seed": "tsx server/seed.ts --dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.107.2",
    "better-sqlite3": "^13.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^1.74.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "playwright": "^1.65.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
